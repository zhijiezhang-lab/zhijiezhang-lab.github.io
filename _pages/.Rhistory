legend.title      = element_text(size = 8),
legend.text       = element_text(size = 6),
legend.key.height = unit(0.8,'line'),
legend.background = element_blank(),
legend.key        = element_rect(colour = NA, fill = NA),
plot.tag    = element_text(size = 9.5, face  = 'bold'),
plot.title  = element_text(hjust = 0.5, size = 10),
plot.margin = margin(t = 0.5, r = 0.1, b = 0, l = 0.1, unit = "cm")) + theme_bw()
rm(dat_raw)
file_names <- list.files('dat/')
for (file in file_names){
if (!exists('dat_raw')){
dat_raw <- read.delim(file.path('dat', file), header = T, skip = 4, dec = ',')
# if ('Laser.focus.score..ZZ_2sp_base.' %in% (dat_raw %>% names)) {
#   dat_raw <- dat_raw %>% dplyr::select(-Laser.focus.score..ZZ_2sp_base.)
# }
} else {
dat_temp <- read.delim(file.path('dat', file), header = T, skip = 4, dec = ',')
# if ('Laser.focus.score..ZZ_2sp_base.' %in% (dat_temp %>% names)) {
#   dat_temp <- dat_temp %>% dplyr::select(-Laser.focus.score..ZZ_2sp_base.)
# }
dat_raw <- bind_rows(dat_raw, dat_temp)
rm(dat_temp)
}
}
# save(dat_cl, file =  'dat_cl.RData')
load('dat_cl.RData')
list <- colnames(dat_cl)[str_detect(colnames(dat_cl), 'Cell\\.\\.')]
list <- list[!list %>% str_detect('ObjectID|Features.Count_Sum|Line.Length_Average')]
sp_low <- dat_cl %>% filter(sample < 4) %>% group_by(sp) %>% tally() %>% arrange(n) %>% pull(sp) %>% head(5) # some sp do not have enough cells (images)
dat_cl %>% group_by(sp) %>% tally() %>% arrange(n)
dat  <- dat_cl %>%  filter(sample < 4|sp %in% sp_low)# %>%
# filter(sp != '17')
dat <- dat %>% filter(!sp %in% c('16', '56', '38'))
sp_filter <- sample(dat$sp %>% unique, 7)
dat <- dat %>% filter(sp %in% c(sp_filter))
no_sp <- dat %>% pull(sp) %>% unique %>% length
dat <- dat %>%
left_join(tibble(sp = dat$sp %>% unique, sp_id = 0:(no_sp - 1))) %>% # python starts from 0
mutate(sp_id = as.factor(sp_id)) %>% droplevels()
# remove the sp not included in the final exp
dat <- dat[sample(nrow(dat), nrow(dat)),] # randomize the data to get a random sample for the test data
means <- dat %>% summarise_if(is.numeric, mean, na.rm = TRUE) %>% t %>% as.vector() # save it for later prediction
sds <-   dat %>% summarise_if(is.numeric, sd,   na.rm = TRUE) %>% t %>% as.vector()
# fill NAs as mean, and scale
no_vars <- 78 #length(list)
for (i in 1:no_vars){
dat[,i][is.na(dat[,i])] <- means[i]
if (sds[i] != 0) { # nan can occur after the scaling because sd is 0
dat[,i] <- (dat[,i] - means[i])/sds[i]
} else {
dat[,i] <- means[i]  # deal with NA
}
}
# split the data (80% for training, 20% for testing the accuracy)
no <- round(nrow(dat) * 0.8)
dat_train <- dat[1:no,]
dat_test <- dat[(no+1):nrow(dat),]
dat_train_x <- dat_train[,1:(no_vars)] %>% as.matrix()
dat_train_y <- dat_train$sp_id
dat_train_y <- to_categorical(dat_train_y, no_sp)
install_te
library(tensorflow)
dat_train_y <- to_categorical(dat_train_y, no_sp)

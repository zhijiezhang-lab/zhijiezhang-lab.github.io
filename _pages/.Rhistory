'17', '23', '38', '56', '65', 'G8', '40'),
sp_name = c('Chlamydomonas reinhardtii',
'Scenedesmus sp.',
'Chlorella minutissima',
'Chlamydomonas oblonga',
'Choricystis minor',
'Scenedesmus obliquus',
'Scenedesmus intermedius',
'Scenedesmus quadricauda',
'Pediastrum boryanum ',
'Monoraphidium obtusum',
'Monoraphidium contortum',
'Chlamydomonas klinobasis',
'Chlorella sp.',
'Vitreochlamys aulata',
'Monoraphidium minutum'
),
plate_4_sp = c(rep(1, 8), rep(2, 7)),
row = rep(LETTERS[1:8], 2)[1:15]
) %>%
mutate(sp_abb = str_replace(sp_name, '[a-z]{1,}\\s', '_'),
sp_abb = ifelse(str_detect(sp_name, 'Chlamy'),
'Chla',
sp_abb
),
sp_abb = ifelse(str_detect(sp_name, 'Cho'),
'Cho',
sp_abb
),
sp_abb = paste(sp_abb, sp, sep = '_')
)
theme <-theme(panel.background = element_blank(),
panel.border     = element_rect(fill = NA),
strip.background = element_blank(),
strip.text.x = element_text(size = 10),
axis.text.x = element_text(size = 8, angle = 0, hjust = 0.5, colour = 'black'),
